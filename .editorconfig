# Mesmo formato de arquivo em qualquer editor (VS Code, Cursor, Codex, Claude…).
# O fim de linha LF evita que um arquivo inteiro apareça como alterado e entre
# em conflito com o trabalho do outro sócio (ver também o .gitattributes).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
