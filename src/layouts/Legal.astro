---
// Páginas de texto (Privacy, Legal notice): barra simples e coluna de leitura.
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <header class="topbar on-dark">
    <div class="topbar__inner">
      <a class="topbar__brand" href="/">
        <img src="/img/emblema-navy.svg" alt="" width="36" height="36" />
        <span>Cap Soleil</span>
      </a>
      <a class="topbar__back" href="/">Back to the club</a>
    </div>
  </header>
  <main id="main" class="legal">
    <svg class="ornament" aria-hidden="true" focusable="false"><use href="#sun-rule"></use></svg>
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .topbar {
    background: var(--navy);
    color: var(--cream);
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--wide);
    margin-inline: auto;
    padding: 0.75rem var(--gutter);
  }

  .topbar__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--serif-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .topbar__back {
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .topbar a:hover {
    color: var(--gold);
  }

  .legal {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(3rem, 9vw, 5rem) var(--gutter) clamp(4rem, 10vw, 6rem);
  }

  .legal .ornament {
    margin-bottom: 1.5rem;
  }

  .legal :global(h1) {
    font-size: clamp(2.4rem, 7vw, 3.4rem);
    margin-bottom: 0.5rem;
  }

  .legal :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.6rem;
  }

  .legal :global(.legal__updated) {
    color: var(--muted);
    font-style: italic;
  }

  .legal :global(ul) {
    padding-left: 1.2rem;
  }

  .legal :global(li) {
    margin-bottom: 0.4rem;
  }

  .legal :global(li::marker) {
    color: var(--gold-deep);
  }

  .legal :global(.placeholder) {
    background: var(--cream-2);
    color: var(--gold-ink);
  }
</style>
