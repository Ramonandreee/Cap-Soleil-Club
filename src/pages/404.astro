---
import Base from "../layouts/Base.astro";
---

<Base title="Out" description="This page is not on the court." noindex bodyClass="out-body">
  <main id="main" class="out on-dark">
    <img src="/img/emblema-navy.svg" alt="" width="120" height="120" />
    <p class="out__call">Out.</p>
    <h1>The ball landed long.</h1>
    <p>This page is not on the court.</p>
    <a class="button button--gold" href="/">Back to the club</a>
  </main>
</Base>

<style>
  .out {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    min-height: 100vh;
    min-height: 100svh;
    padding: 3rem var(--gutter);
    background: var(--navy);
    color: var(--cream);
    text-align: center;
  }

  .out img {
    width: 7rem;
    height: auto;
    margin-bottom: 1rem;
  }

  .out__call {
    margin: 0;
    color: var(--gold);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.36em;
    text-transform: uppercase;
  }

  .out h1 {
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    font-style: italic;
  }

  .out p {
    margin: 0;
    color: var(--on-navy-muted);
  }

  .out .button {
    margin-top: 1.5rem;
  }
</style>
