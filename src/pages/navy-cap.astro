---
import Base from "../layouts/Base.astro";
import ProductHeader from "../components/ProductHeader.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { PRODUCT_COPY } from "../content/site.ts";
import mainImage from "../assets/photos/B3.jpg";
import "../styles/product.css";
---
<Base title="Stitched brim, navy"><ProductHeader /><main id="main" class="product-page"><div class="crumb"><a href="/#boutique">{PRODUCT_COPY.copy60}</a><span>{PRODUCT_COPY.copy61}</span>{PRODUCT_COPY.copy62}</div><section class="piece"><figure class="main-photo"><Image src={mainImage} alt="A navy embroidered cap resting on a limestone ledge." widths={[390, 780, 1122]} sizes="(min-width: 48rem) 45vw, 86vw" format="webp" /><figcaption>{PRODUCT_COPY.copy63}</figcaption></figure><div><p class="kicker">{PRODUCT_COPY.copy64}</p><h1>{PRODUCT_COPY.copy65}<br><i>{PRODUCT_COPY.copy66}</i></h1><p class="subtitle">{PRODUCT_COPY.copy67}</p><p class="description">{PRODUCT_COPY.copy68}</p><div class="colour"><span class="swatch" aria-hidden="true"></span>{PRODUCT_COPY.copy69}</div><dl><div><dt>{PRODUCT_COPY.copy70}</dt><dd>{PRODUCT_COPY.copy71}</dd></div><div><dt>{PRODUCT_COPY.copy72}</dt><dd>{PRODUCT_COPY.copy73}</dd></div><div><dt>{PRODUCT_COPY.copy74}</dt><dd>{PRODUCT_COPY.copy75}</dd></div></dl><a class="button" href="/#la-liste">{PRODUCT_COPY.copy76}</a><p class="access">{PRODUCT_COPY.copy77}</p></div></section><section class="details"><div><p class="kicker">{PRODUCT_COPY.copy78}</p><h2>{PRODUCT_COPY.copy79}</h2><p>{PRODUCT_COPY.copy80}</p><p>{PRODUCT_COPY.copy81}</p></div><div><div class="detail-crop"><Image src={mainImage} alt="Closer view of the same approved product photograph." widths={[390, 780, 1122]} sizes="(min-width: 48rem) 45vw, 86vw" format="webp" /></div><p class="detail-caption">{PRODUCT_COPY.copy82}</p></div></section><div class="related"><a href="/riviera"><small>{PRODUCT_COPY.copy83}</small>{PRODUCT_COPY.copy84}</a><a href="/polo"><small>{PRODUCT_COPY.copy85}</small>{PRODUCT_COPY.copy86}</a><a href="/navy-cap"><small>{PRODUCT_COPY.copy87}</small>{PRODUCT_COPY.copy88}</a></div><p class="return"><a href="/#boutique">{PRODUCT_COPY.copy89}</a></p></main><Footer /></Base>

