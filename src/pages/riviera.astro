---
import Base from "../layouts/Base.astro";
import ProductHeader from "../components/ProductHeader.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { PRODUCT_COPY } from "../content/site.ts";
import mainImage from "../assets/photos/B1.jpg";
import detailImage from "../assets/photos/B1-detail.jpg";
import "../styles/product.css";
---
<Base title="Embroidered, Riviera"><ProductHeader /><main id="main" class="product-page"><div class="crumb"><a href="/#boutique">{PRODUCT_COPY.copy0}</a><span>{PRODUCT_COPY.copy1}</span>{PRODUCT_COPY.copy2}</div><section class="piece"><figure class="main-photo"><Image src={mainImage} alt="Navy half-zip pullover with a small embroidered club emblem on a wicker chair." widths={[390, 780, 1122]} sizes="(min-width: 48rem) 45vw, 86vw" format="webp" /><figcaption>{PRODUCT_COPY.copy3}</figcaption></figure><div><p class="kicker">{PRODUCT_COPY.copy4}</p><h1>{PRODUCT_COPY.copy5}<br><i>{PRODUCT_COPY.copy6}</i></h1><p class="subtitle">{PRODUCT_COPY.copy7}</p><p class="description">{PRODUCT_COPY.copy8}</p><div class="colour"><span class="swatch" aria-hidden="true"></span>{PRODUCT_COPY.copy9}</div><dl><div><dt>{PRODUCT_COPY.copy10}</dt><dd>{PRODUCT_COPY.copy11}</dd></div><div><dt>{PRODUCT_COPY.copy12}</dt><dd>{PRODUCT_COPY.copy13}</dd></div><div><dt>{PRODUCT_COPY.copy14}</dt><dd>{PRODUCT_COPY.copy15}</dd></div></dl><a class="button" href="/#la-liste">{PRODUCT_COPY.copy16}</a><p class="access">{PRODUCT_COPY.copy17}</p></div></section><section class="details"><div><p class="kicker">{PRODUCT_COPY.copy18}</p><h2>{PRODUCT_COPY.copy19}</h2><p>{PRODUCT_COPY.copy20}</p><p>{PRODUCT_COPY.copy21}</p></div><div><div class="detail-crop reference-detail"><Image src={detailImage} alt="Folded navy half-zip pullover, with the embroidered club emblem in focus." widths={[390, 780, 1536]} sizes="(min-width: 48rem) 45vw, 86vw" format="webp" loading="lazy" /></div><p class="detail-caption">{PRODUCT_COPY.copy22}</p></div></section><div class="related"><a href="/riviera"><small>{PRODUCT_COPY.copy23}</small>{PRODUCT_COPY.copy24}</a><a href="/polo"><small>{PRODUCT_COPY.copy25}</small>{PRODUCT_COPY.copy26}</a><a href="/navy-cap"><small>{PRODUCT_COPY.copy27}</small>{PRODUCT_COPY.copy28}</a></div><p class="return"><a href="/#boutique">{PRODUCT_COPY.copy29}</a></p></main><Footer /></Base>

