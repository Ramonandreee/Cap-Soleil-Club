---
import Base from "../layouts/Base.astro";
import ProductHeader from "../components/ProductHeader.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { PRODUCT_COPY } from "../content/site.ts";
import mainImage from "../assets/photos/B2.jpg";
import "../styles/product.css";
---
<Base title="Cotton polo, cream"><ProductHeader /><main id="main" class="product-page"><div class="crumb"><a href="/#boutique">{PRODUCT_COPY.copy30}</a><span>{PRODUCT_COPY.copy31}</span>{PRODUCT_COPY.copy32}</div><section class="piece"><figure class="main-photo"><Image src={mainImage} alt="A cream cotton polo on a limestone table beside a wooden racket." widths={[390, 780, 1122]} sizes="(min-width: 48rem) 45vw, 86vw" format="webp" /><figcaption>{PRODUCT_COPY.copy33}</figcaption></figure><div><p class="kicker">{PRODUCT_COPY.copy34}</p><h1>{PRODUCT_COPY.copy35}<br><i>{PRODUCT_COPY.copy36}</i></h1><p class="subtitle">{PRODUCT_COPY.copy37}</p><p class="description">{PRODUCT_COPY.copy38}</p><div class="colour"><span class="swatch swatch--cream" aria-hidden="true"></span>{PRODUCT_COPY.copy39}</div><dl><div><dt>{PRODUCT_COPY.copy40}</dt><dd>{PRODUCT_COPY.copy41}</dd></div><div><dt>{PRODUCT_COPY.copy42}</dt><dd>{PRODUCT_COPY.copy43}</dd></div><div><dt>{PRODUCT_COPY.copy44}</dt><dd>{PRODUCT_COPY.copy45}</dd></div></dl><a class="button" href="/#la-liste">{PRODUCT_COPY.copy46}</a><p class="access">{PRODUCT_COPY.copy47}</p></div></section><section class="details"><div><p class="kicker">{PRODUCT_COPY.copy48}</p><h2>{PRODUCT_COPY.copy49}</h2><p>{PRODUCT_COPY.copy50}</p><p>{PRODUCT_COPY.copy51}</p></div><div><div class="detail-crop"><Image src={mainImage} alt="Closer view of the same approved product photograph." widths={[390, 780, 1122]} sizes="(min-width: 48rem) 45vw, 86vw" format="webp" /></div><p class="detail-caption">{PRODUCT_COPY.copy52}</p></div></section><div class="related"><a href="/riviera"><small>{PRODUCT_COPY.copy53}</small>{PRODUCT_COPY.copy54}</a><a href="/polo"><small>{PRODUCT_COPY.copy55}</small>{PRODUCT_COPY.copy56}</a><a href="/navy-cap"><small>{PRODUCT_COPY.copy57}</small>{PRODUCT_COPY.copy58}</a></div><p class="return"><a href="/#boutique">{PRODUCT_COPY.copy59}</a></p></main><Footer /></Base>

