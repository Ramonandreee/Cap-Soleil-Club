---
// Ato II · Les Règles: as Regras do Clube. Valores, sem falar de produto.
import { RULES } from "../content/site.ts";
const numerals = ["I", "II", "III", "IV", "V", "VI", "VII"];
---

<section class="rules on-dark" id="regles" aria-labelledby="rules-title">
  <div class="rules__inner">
    <header class="act-head" data-reveal>
      <svg class="ornament" aria-hidden="true" focusable="false"><use href="#sun-rule"></use></svg>
      <h2 class="act-title" id="rules-title">
        <span class="act-title__numeral">{RULES.numeral}</span><span class="act-title__dot" aria-hidden="true">·</span><span>{RULES.title}</span>
      </h2>
      <p class="rules__subtitle">{RULES.subtitle}</p>
    </header>

    <ol class="rules__list" role="list">
      {RULES.items.map((rule, i) => (
        <li class="rules__item" data-reveal>
          <span class="rules__no" aria-hidden="true">{numerals[i]}.</span>
          <span class="rules__text">{rule}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rules {
    background: linear-gradient(transparent, var(--navy-deep));
    color: var(--cream);
    padding: clamp(5rem, 14vw, 9rem) var(--gutter);
  }

  .rules__inner {
    max-width: 46rem;
    margin-inline: auto;
  }

  .rules__subtitle {
    margin: 0;
    color: var(--on-navy-muted);
    font-style: italic;
  }

  .rules__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(184 155 94 / 0.55);
  }

  .rules__item {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: clamp(1.4rem, 3.5vw, 2rem) 0;
    border-bottom: 1px solid rgb(184 155 94 / 0.55);
  }

  .rules__no {
    color: var(--gold-deep);
    font-family: var(--serif-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .rules__text {
    font-family: var(--serif-display);
    font-size: clamp(1.6rem, 4.6vw, 2.6rem);
    font-style: italic;
    line-height: 1.2;
  }

  @media (min-width: 40rem) {
    .rules__item {
      grid-template-columns: 5rem 1fr;
    }
  }
</style>
