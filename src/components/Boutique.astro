---
// Ato III · La Boutique: fragmentos da Pro Shop em close, sem preço e sem nome de produto.
import Photo from "./Photo.astro";
import { BOUTIQUE } from "../content/site.ts";
const [embroidered, knit, brim] = BOUTIQUE.fragments;
---

<section class="boutique" id="boutique" aria-labelledby="boutique-title">
  <div class="boutique__inner">
    <header class="act-head boutique__head" data-reveal>
      <svg class="ornament" aria-hidden="true" focusable="false"><use href="#sun-rule"></use></svg>
      <h2 class="act-title" id="boutique-title">
        <span class="act-title__numeral">{BOUTIQUE.numeral}</span><span class="act-title__dot" aria-hidden="true">·</span><span>{BOUTIQUE.title}</span>
      </h2>
      <p class="boutique__intro">{BOUTIQUE.intro}</p>
    </header>

    <ul class="boutique__fragments" role="list">
      <li data-reveal>
        <figure class="fragment">
          <a class="fragment__zoom" href="/riviera">
          <Photo id="B1" class="fragment__photo" sizes="(min-width: 48rem) 22rem, 90vw">
            <svg viewBox="0 0 240 300" aria-hidden="true" focusable="false">
            <defs>
              <pattern id="knit-navy" width="12" height="14" patternUnits="userSpaceOnUse">
                <path d="M0 0L6 7L12 0M0 7L6 14L12 7" fill="none" stroke="#2b3858" stroke-width="2.4"></path>
              </pattern>
              <filter id="thread-shadow" x="-10%" y="-10%" width="120%" height="120%">
                <feDropShadow dx="0" dy="1.6" stdDeviation="1.1" flood-color="#0b1120" flood-opacity=".7"></feDropShadow>
              </filter>
            </defs>
            <rect width="240" height="300" fill="#1f2a44"></rect>
            <rect width="240" height="300" fill="url(#knit-navy)"></rect>
            <image href="/img/emblema-navy.svg" x="48" y="78" width="144" height="144" filter="url(#thread-shadow)"></image>
            <path class="fragment__frame" d="M12.5 12.5H227.5V287.5H12.5Z"></path>
          </svg>
          </Photo>
          </a>
          <figcaption><span class="caps">Nº {embroidered.no}</span><span>{embroidered.caption}</span></figcaption>
        </figure>
      </li>
      <li data-reveal>
        <figure class="fragment">
          <a class="fragment__zoom" href="/polo">
          <Photo id="B2" class="fragment__photo" sizes="(min-width: 48rem) 22rem, 90vw">
            <svg viewBox="0 0 240 300" aria-hidden="true" focusable="false">
            <rect x=".5" y=".5" width="239" height="299" fill="#fbf8f2" stroke="#ece4d4"></rect>
            <path class="fragment__ribs" d="M16 0V300M224 0V300M82 96V300M158 96V300"></path>
            <path class="fragment__cable" d="M44 24Q64 33 44 42Q24 51 44 60Q64 69 44 78Q24 87 44 96Q64 105 44 114Q24 123 44 132Q64 141 44 150Q24 159 44 168Q64 177 44 186Q24 195 44 204Q64 213 44 222Q24 231 44 240Q64 249 44 258Q24 267 44 276Q64 285 44 294Q24 297 44 300M44 24Q24 33 44 42Q64 51 44 60Q24 69 44 78Q64 87 44 96Q24 105 44 114Q64 123 44 132Q24 141 44 150Q64 159 44 168Q24 177 44 186Q64 195 44 204Q24 213 44 222Q64 231 44 240Q24 249 44 258Q64 267 44 276Q24 285 44 294Q64 297 44 300M120 150Q140 159 120 168Q100 177 120 186Q140 195 120 204Q100 213 120 222Q140 231 120 240Q100 249 120 258Q140 267 120 276Q100 285 120 294Q140 297 120 300M120 150Q100 159 120 168Q140 177 120 186Q100 195 120 204Q140 213 120 222Q100 231 120 240Q140 249 120 258Q100 267 120 276Q140 285 120 294Q100 297 120 300M196 24Q216 33 196 42Q176 51 196 60Q216 69 196 78Q176 87 196 96Q216 105 196 114Q176 123 196 132Q216 141 196 150Q176 159 196 168Q216 177 196 186Q176 195 196 204Q216 213 196 222Q176 231 196 240Q216 249 196 258Q176 267 196 276Q216 285 196 294Q176 297 196 300M196 24Q176 33 196 42Q216 51 196 60Q176 69 196 78Q216 87 196 96Q176 105 196 114Q216 123 196 132Q176 141 196 150Q216 159 196 168Q176 177 196 186Q216 195 196 204Q176 213 196 222Q216 231 196 240Q176 249 196 258Q216 267 196 276Q176 285 196 294Q216 297 196 300"></path>
            <path class="fragment__vneck fragment__vneck--outer" d="M58 0L120 124L182 0"></path>
            <path class="fragment__vneck fragment__vneck--inner" d="M76 0L120 92L164 0"></path>
          </svg>
          </Photo>
          </a>
          <figcaption><span class="caps">Nº {knit.no}</span><span>{knit.caption}</span></figcaption>
        </figure>
      </li>
      <li data-reveal>
        <figure class="fragment">
          <a class="fragment__zoom" href="/navy-cap">
          <Photo id="B3" class="fragment__photo" sizes="(min-width: 48rem) 22rem, 90vw">
            <svg viewBox="0 0 240 300" aria-hidden="true" focusable="false">
            <defs>
              <pattern id="linen" width="6" height="6" patternUnits="userSpaceOnUse">
                <path d="M0 .5H6M.5 0V6" stroke="#b9a885" stroke-width=".6" stroke-opacity=".7"></path>
              </pattern>
            </defs>
            <rect width="240" height="300" fill="#c9b998"></rect>
            <rect width="240" height="300" fill="url(#linen)"></rect>
            <ellipse cx="128" cy="214" rx="104" ry="11" fill="#1f2a44" fill-opacity=".16"></ellipse>
            <path d="M36 200C36 130 74 98 112 98C148 98 172 128 176 200Z" fill="#1f2a44"></path>
            <path d="M112 100C98 132 86 164 80 200M112 100C124 132 134 164 138 200" fill="none" stroke="#2b3858" stroke-width="1.6"></path>
            <circle cx="112" cy="97" r="5" fill="#2b3858"></circle>
            <svg x="118" y="160" width="50" height="6" viewBox="0 0 240 28" class="fragment__sun"><use href="#sun-rule"></use></svg>
            <path d="M36 200H176" stroke="#18213a" stroke-width="5"></path>
            <path d="M150 194C180 186 214 188 230 199C214 210 178 212 150 206Z" fill="#18213a"></path>
            <path class="fragment__stitch" d="M158 197C184 192 208 193 220 199M160 202C184 199 204 199 214 202"></path>
            <path class="fragment__frame fragment__frame--ink" d="M12.5 12.5H227.5V287.5H12.5Z"></path>
          </svg>
          </Photo>
          </a>
          <figcaption><span class="caps">Nº {brim.no}</span><span>{brim.caption}</span></figcaption>
        </figure>
      </li>
    </ul>

    <p class="boutique__note" data-reveal>{BOUTIQUE.note}</p>
  </div>
</section>

<style>
  .boutique {
    background: var(--cream-2);
    padding: clamp(5rem, 14vw, 9rem) var(--gutter);
  }

  .boutique__inner {
    max-width: var(--wide);
    margin-inline: auto;
  }

  .boutique__intro {
    max-width: 30ch;
    text-wrap: balance;
    margin: 0;
    font-family: var(--serif-display);
    font-size: clamp(1.45rem, 4vw, 2rem);
    font-style: italic;
    line-height: 1.25;
  }

  .boutique__fragments {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fragment {
    max-width: 22rem;
    margin: 0 auto;
  }

  .fragment > svg,
  .fragment > :global(.fragment__photo) {
    width: 100%;
    height: auto;
    box-shadow: 0 1px 2px rgb(31 42 68 / 0.12), 0 18px 40px -24px rgb(31 42 68 / 0.45);
  }

  .fragment > :global(.fragment__photo) {
    aspect-ratio: 4 / 5;
  }

  .fragment figcaption {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1rem;
    font-style: italic;
    text-align: center;
  }

  .fragment figcaption .caps {
    color: var(--navy);
    font-size: 0.75rem;
    font-style: normal;
  }

  .fragment__frame {
    fill: none;
    stroke: var(--gold);
    stroke-opacity: 0.8;
  }

  .fragment__frame--ink {
    stroke: var(--navy);
    stroke-opacity: 0.45;
  }

  .fragment__ribs,
  .fragment__cable {
    fill: none;
    stroke: var(--stone);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .fragment__ribs {
    stroke-opacity: 0.6;
  }

  .fragment__vneck {
    fill: none;
    stroke: var(--navy);
  }

  .fragment__vneck--outer {
    stroke-width: 6;
  }

  .fragment__vneck--inner {
    stroke: var(--gold);
    stroke-width: 2.5;
  }

  .fragment__sun {
    color: var(--gold);
  }

  .fragment__stitch {
    fill: none;
    stroke: var(--ivory);
    stroke-dasharray: 3 4;
    stroke-opacity: 0.55;
    stroke-width: 1.2;
  }

  .boutique__note {
    max-width: 30rem;
    margin: clamp(3rem, 7vw, 4.5rem) auto 0;
    color: var(--muted);
    text-align: center;
  }

  @media (min-width: 48rem) {
    .boutique__fragments {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }

    .boutique__fragments li:nth-child(2) {
      margin-top: 4rem;
    }
  }

/* Refinamento editorial aprovado: respiro, proporção e alinhamento. */
.boutique { background: var(--cream); padding-block: clamp(4.5rem, 8vw, 6.5625rem); }
.boutique__intro { color: var(--muted); font-size: 1.4375rem; }
.boutique__fragments { gap: 1.875rem; }
.fragment { max-width: none; }
.fragment > svg, .fragment > :global(.fragment__photo) { box-shadow: none; }
.fragment figcaption { text-align: left; padding: 1.25rem 0 .9375rem; margin-top: 0; border-bottom: 1px solid rgb(184 155 94 / .32); }
.boutique__note { font-size: 1.0625rem; margin-top: 3.5rem; }
@media(min-width:48rem) { .boutique__fragments li:nth-child(2) { margin-top: 0; } }
@media(max-width:47.999rem) { .fragment { max-width: 26rem; } }

  /* Aproximação discreta, contida na moldura e sem ícones. */
  .fragment__zoom { display: block; overflow: hidden; aspect-ratio: 4 / 5; }
  .fragment__zoom > :global(.fragment__photo) { width: 100%; height: 100%; transform: scale(1); transform-origin: 50% 42%; transition: transform 900ms var(--ease); }
  .fragment__zoom:focus-visible { outline: 2px solid var(--gold-ink); outline-offset: 5px; }
  .fragment__zoom:focus-visible > :global(.fragment__photo) { transform: scale(1.065); }
  @media (hover: hover) and (pointer: fine) { .fragment__zoom:hover > :global(.fragment__photo) { transform: scale(1.065); } }
  @media (prefers-reduced-motion: reduce) { .fragment__zoom > :global(.fragment__photo) { transition: none; } .fragment__zoom:hover > :global(.fragment__photo), .fragment__zoom:focus-visible > :global(.fragment__photo) { transform: none; } }

/* Título e introdução compartilham a grade; fotografias preservadas. */
.boutique { padding-block: 5.3125rem 4.6875rem; }
.boutique__inner { max-width: 68.75rem; }
.boutique__head { display: flex; flex-direction: row; justify-content: space-between; align-items: end; text-align: left; gap: 2.5rem; margin-bottom: 2.5rem; }
.boutique__head .ornament { display: none; }
.boutique__head .act-title { display: block; font-size: 3rem; margin: 0; }
.boutique__head .act-title__numeral { display: block; font-size: .6875rem; letter-spacing: .125rem; margin-bottom: .875rem; color: var(--gold-ink); }
.boutique__head .act-title__dot { display: none; }
.boutique__intro { max-width: 16.875rem; font-size: 1.3125rem; line-height: 1.4; margin: 0 0 .3125rem; }
.boutique__fragments { gap: 1.75rem; }
.fragment figcaption { display: flex; gap: 1.125rem; align-items: baseline; line-height: 1.45; font-size: 1.0625rem; padding: 1.0625rem 0; }
.fragment figcaption .caps { font-size: .625rem; letter-spacing: .1rem; color: var(--gold-ink); white-space: nowrap; }
.boutique__note { font-family: var(--serif-display); font-style: italic; font-size: 1.5625rem; line-height: 1.4; margin-top: 2.5rem; }
@media(max-width:43.75rem) { .boutique { padding-block: 4.0625rem 3.75rem; } .boutique__head { display: block; margin-bottom: 1.875rem; } .boutique__head .act-title { font-size: 2.5rem; margin-bottom: 1.125rem; } .boutique__intro { max-width: none; font-size: 1.25rem; } .boutique__note { font-size: 1.4375rem; } }
</style>


