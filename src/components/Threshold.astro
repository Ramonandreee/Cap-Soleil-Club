    </g>
  </svg>
</section>

<script>
  import "../scripts/sky.ts";
</script>

<style>
  .threshold {
    --sun-x: 0;
    --sun-y: 0;
    --glitter: 0.7;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: linear-gradient(to bottom, var(--sky-top) 0%, var(--sky-top) 25%, var(--sky-low) 100%);
    color: var(--cream);
  }

  /* Transições só depois do primeiro quadro: a luz inicial entra pronta
     (animar o céu na abertura custaria caro em celulares). */
  .threshold.is-settled {
    transition:
      --sky-top 1.6s var(--ease),
      --sky-low 1.6s var(--ease),
      --glow 1.6s var(--ease),
      --glow-opacity 1.6s var(--ease),
      --sea 1.6s var(--ease),
      --coast 1.6s var(--ease),
      --ground 1.6s var(--ease),
      --sun 1.6s var(--ease),
      --court-lines 1.6s var(--ease),
      --lamp 1.6s var(--ease),
      --stars 1.6s var(--ease),
      color 1.6s var(--ease);
  }

  .threshold[data-ink="light"] {
    color: var(--navy);
  }

  .threshold__stars {
    position: absolute;
    inset: 0 0 auto;
    width: 100%;
    height: 70%;
    fill: #f4efe6;
    opacity: var(--stars);
    pointer-events: none;
  }

  .threshold__clock {
    position: absolute;
    top: 1.25rem;
    right: var(--gutter);
    left: var(--gutter);
    z-index: 1;
    margin: 0;
    color: var(--gold);
    font-size: 0.6875rem;
    letter-spacing: 0.28em;
    text-align: center;
  }

  .threshold[data-ink="light"] .threshold__clock,
  .threshold[data-ink="light"] .threshold__club {
    color: var(--gold-ink);
  }

  .threshold__clock time {
    font-variant-numeric: lining-nums tabular-nums;
  }

  .threshold__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding: 4.5rem var(--gutter) 2rem;
    text-align: center;
  }

  .threshold__emblem {
    width: clamp(7rem, 30vw, 11rem);
    margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
  }

  .threshold__emblem :global(.threshold__mark) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .threshold[data-ink="light"] .threshold__emblem :global(.threshold__mark) {
    --emblem-ink: #1f2a44;
    --emblem-paper: #f4efe6;
  }

  .threshold__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.3rem);
  }

  .threshold__name {
    padding-left: 0.12em; /* compensa o espaçamento depois da última letra */
    font-size: clamp(2.35rem, 9.6vw, 5.5rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .threshold__club {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--gold);
    font-family: var(--serif-text);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.36em;
    line-height: 1;
    text-transform: uppercase;
  }

  .threshold__club::before,
  .threshold__club::after {
    content: "";
    width: clamp(1.5rem, 6vw, 3rem);
    height: 1px;
    background: currentColor;
  }

  .threshold__club::after {
    margin-left: -0.36em;
  }

  .threshold__line,
  .threshold__phase-line {
    max-width: 26ch;
    margin: 1.5rem auto 0;
    font-family: var(--serif-display);
    font-size: clamp(1.35rem, 4.6vw, 1.85rem);
    font-style: italic;
    line-height: 1.3;
    text-wrap: balance;
  }

  .threshold__phase-line {
    max-width: 34ch;
    margin-top: 0.4rem;
    color: var(--gold);
    font-size: clamp(1.1rem, 3.6vw, 1.4rem);
  }

  .threshold[data-ink="light"] .threshold__phase-line {
    color: var(--gold-ink);
  }

  .threshold__cta {
    margin-top: 2.25rem;
  }

  .threshold[data-ink="light"] .threshold__cta {
    border-color: var(--gold-ink);
  }

  .threshold[data-ink="light"] .threshold__cta:hover {
    background: var(--navy);
    border-color: var(--navy);
    color: var(--cream);
  }

  /* Ilustração */
  .scene {
    width: 100%;
    overflow: visible; /* o sol do meio-dia sobe acima do desenho */
    /* Nunca mais larga que 4:1, para o sol não ser cortado em telas largas */
    height: max(clamp(12rem, 34vh, 24rem), 25vw);
  }

  .scene__sun {
    fill: var(--sun);
    transform: translate(calc(var(--sun-x) * 1px), calc(var(--sun-y) * 1px));
  }

  .is-settled .scene__sun {
    transition: transform 1.6s var(--ease);
  }

  .scene__rays {
    fill: none;
    stroke: var(--sun);
    stroke-linecap: round;
    stroke-width: 2.5;
  }

  .scene__follow {
    transform: translateX(calc(var(--sun-x) * 1px));
  }

  .is-settled .scene__follow {
    transition: transform 1.6s var(--ease);
  }

  .scene__glow {
    opacity: var(--glow-opacity);
  }

  .scene__glow-stop {
    stop-color: var(--glow);
  }

  .scene__coast {
    fill: var(--coast);
  }

  .scene__sea {
    fill: var(--sea);
  }

  .scene__glitter {
    fill: none;
    stroke: var(--sun);
    stroke-linecap: round;
    stroke-opacity: var(--glitter);
    stroke-width: 2.5;
  }

  .scene__ground {
    fill: var(--ground);
  }

  .scene__terrace {
    fill: var(--stone);
    fill-opacity: 0.85;
  }

  .scene__lamp {
    opacity: var(--lamp);
  }

  .scene__clay {
    fill: var(--clay);
  }

  .scene__shadow {
    fill: var(--navy);
    fill-opacity: 0.22;
  }

  .scene__lines,
  .scene__net-tape {
    fill: none;
    stroke: var(--ivory);
    stroke-linecap: square;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .scene__lines {
    stroke-opacity: var(--court-lines);
  }

  .scene__net {
    fill: var(--navy);
    fill-opacity: 0.6;
  }

  .scene__pines {
    fill: var(--pine);
  }

  .scene__branches {
    fill: none;
    stroke: var(--pine);
    stroke-linecap: round;
    stroke-width: 5;
  }

  /* O emblema surge uma vez, de baixo para cima, como o sol nascendo. */
  @media (prefers-reduced-motion: no-preference) {
    .threshold__emblem {
      animation: rise 1.6s var(--ease) both;
    }

    /* O título entra sem animação: é o primeiro texto que a pessoa vê (LCP). */
    .threshold__cta {
      animation: fade 1.2s var(--ease) 0.6s both;
    }
  }

  @keyframes rise {
    from {
      clip-path: inset(100% 0 0 0);
      opacity: 0.2;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 48rem) {
    .threshold__clock {
      left: auto;
      text-align: right;
    }
  }
</style>
