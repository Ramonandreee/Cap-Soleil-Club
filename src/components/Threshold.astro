    </g>
    <g class="scene__pines">
      <g><path d="M291 500C270 337.1 238 178 242 132L250 132C254 178 282 337.1 309 500Z"></path><path class="scene__branches" d="M246 172Q178.5 146 111 134M246 172Q214.5 146 183 134M246 172Q254.5 146 263 134M246 172Q290.5 146 335 134M246 172Q326.5 146 407 134"></path><ellipse cx="107.3" cy="119.4" rx="84.2" ry="29.7"></ellipse><ellipse cx="206.9" cy="121" rx="90.4" ry="33"></ellipse><ellipse cx="290" cy="116.3" rx="93.4" ry="30.8"></ellipse><ellipse cx="399.4" cy="114.1" rx="75.1" ry="32.6"></ellipse><ellipse cx="62.3" cy="128.3" rx="46.4" ry="15.8"></ellipse><ellipse cx="427.8" cy="123.7" rx="47" ry="18"></ellipse><ellipse cx="157.9" cy="87.6" rx="72.5" ry="29.5"></ellipse><ellipse cx="261" cy="83.9" rx="91.7" ry="31.6"></ellipse><ellipse cx="346" cy="89.9" rx="72.6" ry="26.1"></ellipse><ellipse cx="233.8" cy="59.3" rx="70.3" ry="25.1"></ellipse><ellipse cx="326.8" cy="63.3" rx="53.9" ry="23.9"></ellipse></g>
