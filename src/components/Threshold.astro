---
// Ato 0 · Le Seuil (a portaria): o céu da hora real no Cap d'Antibes.
// Sem JavaScript, mostra L'Heure (a hora dourada), a imagem da marca.
import Emblem from "./Emblem.astro";
import { THRESHOLD } from "../content/site.ts";

// Estrelas em posições fixas (gerador simples com semente), só aparecem à noite.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
// O centro (emblema e textos) fica sem estrelas, para nada encostar nas letras.
const stars = Array.from({ length: 70 }, () => ({
  cx: Math.round(rand() * 1000 * 10) / 10,
  cy: Math.round(rand() * 560 * 10) / 10,
  r: Math.round((0.6 + rand() * 1.2) * 10) / 10,
}))
  .filter((s) => s.cx < 320 || s.cx > 680 || s.cy < 30)
  .slice(0, 46);
---

<section class="threshold on-dark" id="seuil" data-sky data-phase="heure" data-ink="dark" aria-labelledby="club-name">
  <svg class="threshold__stars" viewBox="0 0 1000 600" preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
    {stars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} />)}
  </svg>

  <p class="threshold__clock caps" data-clock hidden>
    <span>Côte d’Azur</span><span aria-hidden="true"> · </span><time data-clock-time></time><span aria-hidden="true"> · </span><span data-clock-phase></span>
  </p>

  <div class="threshold__inner">
    <div class="threshold__emblem">
      <Emblem class="threshold__mark" />
    </div>
    <h1 class="threshold__title" id="club-name">
      <span class="threshold__name">Cap Soleil</span>
      <span class="threshold__club">Lawn Tennis Club</span>
    </h1>
    <p class="threshold__line">{THRESHOLD.line}</p>
    <p class="threshold__phase-line" data-phase-line hidden></p>
    <a class="button button--gold threshold__cta" href="#la-liste">{THRESHOLD.cta}</a>
  </div>

  <svg class="scene" viewBox="0 0 2000 500" preserveAspectRatio="xMidYMax slice" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="scene-glow" cx="1000" cy="150" r="150" gradientUnits="userSpaceOnUse" gradientTransform="translate(1000 150) scale(5.2 1) translate(-1000 -150)">
        <stop class="scene__glow-stop" offset="0" stop-opacity="1"></stop>
        <stop class="scene__glow-stop" offset=".5" stop-opacity=".28"></stop>
        <stop class="scene__glow-stop" offset="1" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id="scene-lamp">
        <stop offset="0" stop-color="#f6d9a0" stop-opacity=".9"></stop>
        <stop offset="1" stop-color="#f6d9a0" stop-opacity="0"></stop>
      </radialGradient>
      <clipPath id="scene-above-horizon"><rect x="-1000" y="-600" width="4000" height="750"></rect></clipPath>
    </defs>
    <g class="scene__follow">
      <rect class="scene__glow" x="-1000" width="4000" height="150" fill="url(#scene-glow)"></rect>
    </g>
    <g clip-path="url(#scene-above-horizon)">
      <g class="scene__sun">
        <circle cx="1000" cy="150" r="46"></circle>
        <path class="scene__rays" d="M937 138.9L897.6 131.9M939.9 128.1L919.2 120.6M944.6 118L909.9 98M951 108.9L934.1 94.7M958.9 101L933.2 70.3M968 94.6L957 75.5M978.1 89.9L964.4 52.3M988.9 87L985.1 65.3M1000 86L1000 46M1011.1 87L1014.9 65.3M1021.9 89.9L1035.6 52.3M1032 94.6L1043 75.5M1041.1 101L1066.8 70.3M1049 108.9L1065.9 94.7M1055.4 118L1090.1 98M1060.1 128.1L1080.8 120.6M1063 138.9L1102.4 131.9"></path>
      </g>
    </g>
    <path class="scene__coast" d="M0 150V132C90 122 170 118 260 121C360 124 430 136 520 150ZM1330 150C1420 140 1500 128 1590 117C1690 104 1790 109 1880 121C1930 127 1970 134 2000 138V150Z"></path>
    <rect class="scene__sea" y="150" width="2000" height="62"></rect>
    <g class="scene__follow">
      <path class="scene__glitter" d="M954 158H1046M965 166H1035M973 175H1027M980 185H1020M986 196H1014"></path>
    </g>
    <rect class="scene__ground" y="210" width="2000" height="290"></rect>
    <rect class="scene__terrace" y="205" width="2000" height="7"></rect>
    <g class="scene__lamp">
      <circle cx="1236" cy="196" r="42" fill="url(#scene-lamp)"></circle>
      <circle cx="1236" cy="196" r="3.2" fill="#f6d9a0"></circle>
      <path d="M1236 199V212" stroke="#0e1513" stroke-width="2"></path>
    </g>
    <g class="scene__court">
