---
import Emblem from './Emblem.astro';
import { THRESHOLD } from '../content/site.ts';
---
<section class="threshold on-dark" id="seuil" data-sky data-phase="heure" data-ink="dark" aria-labelledby="club-name">
  <p class="threshold__clock caps" data-clock hidden><span>Côte d’Azur · </span><time data-clock-time></time><span> · </span><span data-clock-phase></span></p>
  <div class="threshold__inner">
    <Emblem class="threshold__mark" />
    <h1 id="club-name"><span class="threshold__name">Cap Soleil</span><span class="threshold__club caps">Lawn Tennis Club</span></h1>
    <p class="threshold__line">{THRESHOLD.line}</p>
    <p class="threshold__phase-line" data-phase-line hidden></p>
    <a class="button button--gold" href="#la-liste">{THRESHOLD.cta}</a>
  </div>
</section>
<script>import '../scripts/sky.ts';</script>
<style>
  .threshold { min-height: 100svh; position: relative; display: grid; place-items: start center; padding: clamp(7rem, 15vh, 10rem) var(--gutter) 5rem; color: var(--cream); text-align: center; }
  .threshold__clock { position: absolute; top: 2rem; left: 0; width: 100%; color: var(--cream); font-size: .7rem; }
  .threshold__inner { max-width: 55rem; text-shadow: 0 2px 18px rgb(0 0 0 / .65); }
  .threshold :global(.threshold__mark) { width: 5rem; height: auto; margin: 0 auto 1.5rem; --emblem-ink: #f4efe6; --emblem-paper: #1f2a44; }
  h1 { margin: 0; font-weight: 400; }
  .threshold__name { display: block; font-size: clamp(2.7rem, 6vw, 5rem); letter-spacing: .15em; text-transform: uppercase; }
  .threshold__club { display: block; font-size: .9rem; letter-spacing: .4em; margin-top: .5rem; }
  .threshold__line { font-size: clamp(1.2rem, 3vw, 1.6rem); margin: 2rem 0; }
  .threshold__phase-line { font-style: italic; margin: -1rem 0 1.8rem; }
  .threshold .button { background: rgb(14 21 35 / .6); color: var(--cream); }
</style>
