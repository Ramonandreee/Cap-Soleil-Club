---
import { SITE } from "../config.ts";
import { FOOTER } from "../content/site.ts";
---

<footer class="footer on-dark">
  <div class="footer__inner">
    <div class="footer__brand">
      <img class="footer__emblem" src="/img/emblema-navy.svg" alt="" width="72" height="72" loading="lazy" />
      <p class="footer__name">Cap Soleil <span>Lawn Tennis Club</span></p>
      <p class="footer__place">{FOOTER.place}</p>
    </div>
    <div class="footer__rule" aria-hidden="true"></div>
    <ul class="footer__links" role="list">
      <li><a class="footer__instagram" href={SITE.instagram} aria-label={`Instagram ${SITE.instagramHandle}`} title={SITE.instagramHandle} target="_blank" rel="noopener noreferrer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none" /></svg></a></li>
      {SITE.contactEmail && <li><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></li>}
      <li><a href="/privacy">{FOOTER.privacy}</a></li>
      <li><a href="/legal">{FOOTER.legal}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy);
    border-top: 1px solid rgb(184 155 94 / 0.3);
    color: var(--cream);
    padding: 4rem var(--gutter) 3rem;
  }

  .footer__inner {
    display: grid;
    gap: 1.4rem;
    justify-items: center;
    max-width: var(--wide);
    margin-inline: auto;
    text-align: center;
  }

  .footer__brand {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
  }

  .footer__emblem {
    width: 4rem;
    height: auto;
  }

  .footer__name {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--serif-display);
    font-size: 1.5625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
  }

  .footer__name span {
    color: var(--gold);
    font-family: var(--serif-text);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.32em;
  }

  .footer__place {
    margin: 0;
    color: var(--on-navy-muted);
    font-style: italic;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
  }

  .footer__links a {
    display: inline-block;
    padding: 0.4rem 0;
    color: var(--cream);
  }

  .footer__links a:hover {
    color: var(--gold);
  }

  .footer__rule {
    width: 2.75rem;
    height: 1px;
    background: rgb(184 155 94 / 0.45);
  }

  .footer__links a.footer__instagram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    text-decoration: none;
  }

  .footer__instagram svg { display: block; }

  .footer__links a:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 5px;
  }
</style>
