---
// Barra discreta que aparece depois da portaria (ato 0), com o caminho para a lista.
import { LIST } from "../content/site.ts";
---

<header class="masthead on-dark" data-masthead aria-label="Cap Soleil">
  <div class="masthead__inner">
    <a class="masthead__brand" href="#seuil">
      <img src="/img/emblema-navy.svg" alt="" width="32" height="32" loading="lazy" />
      <span>Cap Soleil</span>
    </a>
    <a class="masthead__link caps" href="#la-liste">{LIST.title}</a>
  </div>
</header>

<script>
  const bar = document.querySelector<HTMLElement>('[data-masthead]');
  const hour = document.querySelector<HTMLElement>('#heure');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let frame = 0;
  let settled = false;
  function paint() {
    frame = 0;
    if (!bar || !hour) return;
    const start = hour.getBoundingClientRect().top + scrollY - innerHeight * .55;
    const distance = scrollY - start;
    if (distance < 0) {
      if (settled || bar.classList.contains('is-shown')) {
        bar.classList.remove('is-shown');
        bar.style.transform = '';
      }
      settled = false;
      return;
    }
    const offset = reduce.matches ? 0 : Math.min(0, -bar.offsetHeight + distance * .65);
    if (settled && offset === 0) return;
    bar.classList.add('is-shown');
    bar.style.transform = offset === 0 ? 'none' : `translateY(${offset}px)`;
    settled = offset === 0;
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(paint); }
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('resize', () => { settled = false; schedule(); });
  reduce.addEventListener('change', () => { settled = false; schedule(); });
  paint();
</script>

<style>
  .masthead {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    background: rgb(20 28 48 / 0.94);
    border-bottom: 1px solid rgb(184 155 94 / 0.35);
    color: var(--cream);
    visibility: hidden;
    transform: translateY(-100%);
    transition: none;
  }

  .masthead.is-shown {
    visibility: visible;
    transform: none;
    transition: none;
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--wide);
    margin-inline: auto;
    padding: 0.55rem var(--gutter);
  }

  .masthead__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--serif-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .masthead__brand img {
    width: 2rem;
    height: 2rem;
  }

  .masthead__link {
    padding: 0.5rem 0;
    color: var(--gold);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .masthead a:hover {
    color: var(--gold);
  }
</style>
