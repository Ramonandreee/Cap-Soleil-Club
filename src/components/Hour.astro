---
// Ato I · L'Heure: a história da marca, uma frase por tela. A rolagem leva a
// luz da hora dourada ao crepúsculo e à primeira estrela (src/scripts/hour.ts).
// Sem JavaScript, as frases passam sobre o céu de L'Heure, parado.
import { HOUR } from "../content/site.ts";

let seed = 11;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: 40 }, () => ({
  cx: Math.round(rand() * 1000),
  cy: Math.round(rand() * 520),
  r: Math.round((0.8 + rand() * 1.4) * 10) / 10,
}));
const pine =
  '<path d="M291 500C270 337.1 238 178 242 132L250 132C254 178 282 337.1 309 500Z"/><path class="hour__branches" d="M246 172Q178.5 146 111 134M246 172Q214.5 146 183 134M246 172Q254.5 146 263 134M246 172Q290.5 146 335 134M246 172Q326.5 146 407 134"/><ellipse cx="107.3" cy="119.4" rx="84.2" ry="29.7"/><ellipse cx="206.9" cy="121" rx="90.4" ry="33"/><ellipse cx="290" cy="116.3" rx="93.4" ry="30.8"/><ellipse cx="399.4" cy="114.1" rx="75.1" ry="32.6"/><ellipse cx="62.3" cy="128.3" rx="46.4" ry="15.8"/><ellipse cx="427.8" cy="123.7" rx="47" ry="18"/><ellipse cx="157.9" cy="87.6" rx="72.5" ry="29.5"/><ellipse cx="261" cy="83.9" rx="91.7" ry="31.6"/><ellipse cx="346" cy="89.9" rx="72.6" ry="26.1"/><ellipse cx="233.8" cy="59.3" rx="70.3" ry="25.1"/><ellipse cx="326.8" cy="63.3" rx="53.9" ry="23.9"/>';
---

<section class="hour on-dark" id="heure" aria-labelledby="hour-title" data-hour>
  <div class="hour__backdrop" aria-hidden="true">
    <svg class="hour__scene" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" focusable="false">
      <defs>
        <linearGradient id="hour-sky" x1="0" y1="0" x2="0" y2="1">
          <stop class="hour__sky-top" offset=".05"></stop>
          <stop class="hour__sky-low" offset=".62"></stop>
        </linearGradient>
        <radialGradient id="hour-glow" cx="500" cy="620" r="420" gradientUnits="userSpaceOnUse" gradientTransform="translate(500 620) scale(1.5 .5) translate(-500 -620)">
          <stop class="hour__glow-stop" offset="0" stop-opacity="1"></stop>
          <stop class="hour__glow-stop" offset=".55" stop-opacity=".25"></stop>
          <stop class="hour__glow-stop" offset="1" stop-opacity="0"></stop>
        </radialGradient>
        <clipPath id="hour-above"><rect width="1000" height="620"></rect></clipPath>
      </defs>
      <rect width="1000" height="1000" fill="url(#hour-sky)"></rect>
      <g class="hour__stars">{stars.map((s) => <circle cx={s.cx} cy={s.cy} r={s.r} />)}</g>
      <rect class="hour__glow" width="1000" height="620" fill="url(#hour-glow)"></rect>
      <g clip-path="url(#hour-above)">
        <circle class="hour__sun" cx="500" cy="560" r="64"></circle>
      </g>
      <path class="hour__coast" d="M0 620V598C60 588 120 580 190 584C260 588 320 604 380 620ZM760 620C800 612 850 606 900 607C940 608 975 612 1000 615V620Z"></path>
      <rect class="hour__sea" y="620" width="1000" height="380"></rect>
      <path class="hour__glitter" d="M452 634H548M462 648H538M470 664H530M478 682H522M486 702H514M492 724H508"></path>
      <g class="hour__pines">
        <g transform="translate(-170 360) scale(1.15)" set:html={pine} />
        <g transform="translate(1170 400) scale(-1.05 1.05)" set:html={pine} />
      </g>
      <g class="hour__terrace">
        <rect class="hour__terrace-floor" y="782" width="1000" height="218"></rect>
        <rect class="hour__rail" y="772" width="1000" height="10"></rect>
        <path class="hour__balusters" d="M40 782V1000M110 782V1000M180 782V1000M250 782V1000M320 782V1000M390 782V1000M460 782V1000M530 782V1000M600 782V1000M670 782V1000M740 782V1000M810 782V1000M880 782V1000M950 782V1000"></path>
      </g>
    </svg>
  </div>

  <div class="hour__content">
  <header class="act-head hour__head" data-reveal>
    <svg class="ornament" aria-hidden="true" focusable="false"><use href="#sun-rule"></use></svg>
    <h2 class="act-title" id="hour-title">
      <span class="act-title__numeral">{HOUR.numeral}</span><span class="act-title__dot" aria-hidden="true">·</span><span>{HOUR.title}</span>
    </h2>
  </header>

  <ol class="hour__lines" role="list">
    {HOUR.lines.map((line, i) => (
      <li class="hour__line" data-line={i}>
        <p>{line}</p>
      </li>
    ))}
  </ol>
  </div>
</section>

<script>
  import "../scripts/hour.ts";
</script>

<style>
  .hour {
    --hour-sun: -110;
    --glitter: 0.7;
    position: relative;
    display: grid;
    overflow: clip;
    background: var(--navy);
    color: var(--cream);
  }

  /* Fundo e texto dividem a mesma célula: o fundo fica parado enquanto as
     frases passam, e nunca invade a seção seguinte. */
  .hour__backdrop,
  .hour__content {
    grid-area: 1 / 1;
  }

  .hour__backdrop {
    position: sticky;
    top: 0;
    align-self: start;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .hour__content {
    position: relative;
  }

  .hour__scene {
    width: 100%;
    height: 100%;
  }

  .hour__sky-top {
    stop-color: var(--sky-top);
  }

  .hour__sky-low {
    stop-color: var(--sky-low);
  }

  .hour__glow {
    opacity: var(--glow-opacity);
  }

  .hour__glow-stop {
    stop-color: var(--glow);
  }

  .hour__stars {
    fill: var(--cream);
    opacity: var(--stars);
  }

  .hour__sun {
    fill: var(--sun);
    transform: translateY(calc(var(--hour-sun) * 1px));
  }

  .hour__coast {
    fill: var(--coast);
  }

  .hour__sea {
    fill: var(--sea);
  }

  .hour__glitter {
    fill: none;
    stroke: var(--sun);
    stroke-linecap: round;
    stroke-opacity: var(--glitter);
    stroke-width: 3;
  }

  .hour__pines {
    fill: var(--pine);
  }

  .hour__pines :global(.hour__branches) {
    fill: none;
    stroke: var(--pine);
    stroke-linecap: round;
    stroke-width: 5;
  }

  .hour__terrace-floor {
    fill: var(--ground);
  }

  .hour__rail {
    fill: var(--stone);
    fill-opacity: 0.55;
  }

  .hour__balusters {
    stroke: var(--stone);
    stroke-opacity: 0.22;
    stroke-width: 9;
  }

  .hour__head {
    position: relative;
    margin: 0;
    padding: 22vh var(--gutter) 0;
  }

  .hour__lines {
    position: relative;
    margin: 0;
    padding: 0 var(--gutter) 20vh;
    list-style: none;
  }

  .hour__line {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 78vh;
    min-height: 78svh;
    text-align: center;
  }

  .hour__line p {
    max-width: 21ch;
    margin: 0;
    font-family: var(--serif-display);
    font-size: clamp(1.85rem, 5.4vw, 3.4rem);
    font-style: italic;
    line-height: 1.22;
    text-shadow: 0 1px 24px rgb(11 17 32 / 0.55);
    text-wrap: balance;
    transition: opacity var(--slow) var(--ease);
  }

  .hour__line:last-child p {
    font-style: normal;
    letter-spacing: 0.01em;
  }

  /* A frase da vez fica acesa; as outras, mais apagadas (ainda legíveis, AA). */
  .hour.is-live .hour__line p {
    opacity: 0.5;
  }

  .hour.is-live .hour__line.is-current p {
    opacity: 1;
  }
</style>
