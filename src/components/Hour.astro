---
import { HOUR } from '../content/site.ts';
---
<section class="hour on-dark" id="heure" aria-labelledby="hour-title" data-hour>
  <header class="act-head hour__head"><svg class="ornament" aria-hidden="true"><use href="#sun-rule"></use></svg><h2 class="act-title" id="hour-title"><span class="act-title__numeral">{HOUR.numeral}</span><span class="act-title__dot" aria-hidden="true">·</span><span>{HOUR.title}</span></h2></header>
  <ol class="hour__lines" role="list">{HOUR.lines.map((line, i) => <li class="hour__line" data-line={i}><p>{line}</p></li>)}</ol>
</section>
<script>import '../scripts/hour.ts';</script>
<style>
  .hour { color: var(--cream); padding-top: 4rem; text-shadow: 0 2px 18px rgb(0 0 0 / .65); }
  .hour__head { margin-bottom: 0; }
  .hour__lines { list-style: none; padding: 0; margin: 0; }
  .hour__line { min-height: 90svh; display: grid; place-items: center; padding: 4rem var(--gutter); }
  .hour__line p { max-width: 46rem; font-size: clamp(2rem, 4vw, 3.3rem); line-height: 1.4; font-style: italic; text-align: center; margin: 0; }
</style>
